{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "aitunnel": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AITUNNEL",
      "options": {
        "baseURL": "https://api.aitunnel.ru/v1"
      },
      "models": {
        "claude-sonnet-4.5": {
          "name": "Claude Sonnet 4.5",
          "limit": {
            "context": 200000,
            "output": 64000
          }
        },
        "gpt-5.2-pro": {
          "name": "GPT-5.2 Pro",
          "limit": {
            "context": 400000,
            "output": 128000
          }
        },
        "moonshotai/kimi-k2": {
          "name": "Kimi K2",
          "limit": {
            "context": 200000,
            "output": 32000
          }
        }
      }
    }
  },
  "model": "aitunnel/claude-sonnet-4-5",
  "small_model": "aitunnel/moonshotai/kimi-k2"
}